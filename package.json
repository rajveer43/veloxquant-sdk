{
  "name": "@veloxquant/sdk",
  "version": "0.5.0",
  "description": "JavaScript/TypeScript SDK for VeloxQuant-MLX: hardware-aware memory optimization and OpenAI-compatible local inference on Apple Silicon.",
  "license": "MIT",
  "author": "Rajveer Rathod",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "import": "./dist/ai-sdk.js",
      "require": "./dist/ai-sdk.cjs"
    },
    "./langchain": {
      "types": "./dist/langchain.d.ts",
      "import": "./dist/langchain.js",
      "require": "./dist/langchain.cjs"
    }
  },
  "bin": {
    "veloxquant": "./bin/veloxquant.js",
    "vq": "./bin/veloxquant.js"
  },
  "files": [
    "dist",
    "bin",
    "media/icon.png"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "keywords": [
    "mlx",
    "apple silicon",
    "quantization",
    "kv cache",
    "llm",
    "local ai",
    "openai",
    "sdk",
    "m1",
    "m2",
    "m3",
    "m4",
    "m5"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rajveer43/veloxquant-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/rajveer43/veloxquant-sdk/issues"
  },
  "homepage": "https://github.com/rajveer43/veloxquant-sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p ./",
    "lint": "eslint src --ext ts",
    "test": "node --import tsx --test test/unit/*.test.ts",
    "test:watch": "node --import tsx --test --watch test/unit/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.0",
    "@langchain/core": "^1.0.0",
    "ai": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/openai-compatible": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^3.0.43",
    "@ai-sdk/provider": "^4.0.10",
    "@langchain/core": "^1.2.9",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "ai": "^7.0.91",
    "eslint": "^8.56.0",
    "openai": "^7.9.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "zod": "^3.25.76"
  }
}
